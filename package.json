{
  "name": "preco",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Base colaborativa e open source de precos a partir de notas fiscais (NFC-e)",
  "scripts": {
    "gerar": "node --disable-warning=ExperimentalWarning src/gerador/index.js",
    "build": "node --disable-warning=ExperimentalWarning src/builder/index.js",
    "compilar": "node src/compilar-web.js && node src/compilar-ondas.js",
    "compilar:ondas": "node src/compilar-ondas.js",
    "pipeline": "npm run gerar && npm run build && npm run compilar",
    "verificar": "node scripts/verificar-site.js",
    "front": "node src/server.js"
  },
  "engines": {
    "node": ">=22.5"
  }
}
